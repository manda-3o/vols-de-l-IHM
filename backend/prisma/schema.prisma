datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id       Int       @id @default(autoincrement())
    email    String    @unique
    name     String
    password String
    bookings Booking[]
}

model Flight {
    id        Int       @id @default(autoincrement())
    code      String    @unique
    route     String
    depTime   String
    arrTime   String
    price     Int
    seats     Int
    aircraft  String
    createdAt DateTime  @default(now())
    bookings  Booking[]
}

model Booking {
    id        Int      @id @default(autoincrement())
    user      User     @relation(fields: [userId], references: [id])
    userId    Int
    flight    Flight   @relation(fields: [flightId], references: [id])
    flightId  Int
    seat      String
    status    String   @default("CONFIRMED")
    createdAt DateTime @default(now())
}
